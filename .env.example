# Copy to .env for local dev (never commit .env). In production these come from
# GitHub Actions secrets and are staged onto Fly by the deploy workflow.

# From the Google Cloud OAuth 2.0 Client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random string used to sign session cookies (openssl rand -hex 32)
SESSION_SECRET=

# Comma-separated allow-list of Google emails permitted to sign in.
# Leave empty to allow any Google account.
ALLOWED_EMAILS=jeromeswannack@gmail.com

# Public base URL (used to build the OAuth redirect URI). For local dev:
# BASE_URL=http://localhost:8080
